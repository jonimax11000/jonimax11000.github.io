---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  project: {
    id: string;
    name: string;
    repoName: string;
    featured: boolean;
    private: boolean;
    url: string;
    demoUrl?: string;
    category: string;
    updatedAt: string;
    languages: string[];
    technologies: string[];
    branches: string[];
    summary: { es: string; en: string };
    highlights?: { es: string[]; en: string[] };
  };
  lang: Lang;
  isFeaturedSection?: boolean;
}

const { project, lang, isFeaturedSection = false } = Astro.props;
const t = ui[lang];
const summaryText = project.summary[lang] || project.summary.es;
const highlightsList = project.highlights?.[lang] || project.highlights?.es || [];
---

<article
  class:list={['card', { 'card-featured': isFeaturedSection || project.featured }]}
  data-project-card
  data-visibility={project.private ? 'private' : 'public'}
  data-languages={project.languages.join(',')}
  data-search={`${project.name} ${project.repoName} ${summaryText} ${project.languages.join(' ')} ${project.technologies.join(' ')} ${project.branches.join(' ')}`.toLowerCase()}
>
  <div class="badge-row">
    {project.private ? (
      <span class="badge badge-private" title={t.featured.privateNotice}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        {t.catalog.visibilityPrivate}
      </span>
    ) : (
      <span class="badge badge-public">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        {t.catalog.visibilityPublic}
      </span>
    )}

    {project.featured && (
      <span class="badge badge-featured">
        ★ {t.featured.badgeFeatured}
      </span>
    )}

    <span class="badge">
      {project.category}
    </span>
  </div>

  <h3 class="project-title">{project.name}</h3>
  <p class="project-summary">{summaryText}</p>

  {highlightsList.length > 0 && (
    <div style="margin-bottom: 0.75rem;">
      <span class="meta-label">{t.featured.keyHighlights}</span>
      <ul class="project-highlights">
        {highlightsList.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  )}

  <div class="meta-group">
    <div>
      <span class="meta-label">{t.featured.languagesLabel}</span>
      <div class="badge-row" style="margin-bottom: 0;">
        {project.languages.map((l) => (
          <span class="badge badge-lang">{l}</span>
        ))}
      </div>
    </div>

    <div>
      <span class="meta-label">{t.featured.techLabel}</span>
      <div class="badge-row" style="margin-bottom: 0;">
        {project.technologies.map((tech) => (
          <span class="badge">{tech}</span>
        ))}
      </div>
    </div>

    {project.branches && project.branches.length > 1 && (
      <div>
        <span class="meta-label">{t.featured.branchesLabel} ({project.branches.length})</span>
        <div class="badge-row" style="margin-bottom: 0;">
          {project.branches.map((br) => (
            <span class="badge badge-branch">⎇ {br}</span>
          ))}
        </div>
      </div>
    )}
  </div>

  <div class="project-footer">
    {project.private ? (
      <span class="private-lock-note">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        {t.catalog.privateNoUrl}
      </span>
    ) : (
      project.url && (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-control"
          aria-label={`${t.catalog.publicRepoLink}: ${project.name}`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.73.5.5 5.74.5 12.02c0 5.1 3.29 9.42 7.86 10.95.58.1.79-.25.79-.56v-2.02c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.12 3.06.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.53 11.53 0 0 0 23.5 12.02C23.5 5.74 18.27.5 12 .5z" />
          </svg>
          {t.featured.viewRepo}
        </a>
      )
    )}

    {project.demoUrl && (
      <a
        href={project.demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-control"
        style="border-color: var(--accent-emerald); color: var(--accent-emerald);"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
        {t.featured.viewDemo}
      </a>
    )}
  </div>
</article>

