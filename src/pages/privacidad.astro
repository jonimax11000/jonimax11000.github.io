---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';

const title = `Aviso Legal y Política de Privacidad (UE, UK, Sudamérica y EE. UU.) — ${profile.name}`;
const description =
  'Aviso Legal y Política de Privacidad Internacional conforme al RGPD (UE), LOPDGDD y LSSI-CE (España), UK GDPR (Reino Unido), LGPD (Brasil) y leyes de Sudamérica, y CCPA/CPRA/COPPA (EE. UU.).';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/privacidad/"
  alternateEsPath="/privacidad/"
  alternateEnPath="/en/privacy/"
>
  <section class="section" aria-labelledby="privacy-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">// AVISO LEGAL · PRIVACIDAD INTERNACIONAL</span>
        <h1 id="privacy-heading" class="section-title">
          Aviso Legal y Política de Privacidad Global
        </h1>
        <p class="section-subtitle">
          Marco jurídico integral para la Unión Europea, Reino Unido, Sudamérica y Estados Unidos. Este portfolio es un sitio estático sin formularios de captura, sin bases de datos de usuarios y sin rastreadores externos.
        </p>
      </div>

      <!-- 1. Identificación del Titular (LSSI-CE Art. 10 / E-Commerce Directive) -->
      <div class="card" style="margin-bottom:2rem;">
        <h2 style="font-size:1.3rem;margin:0 0 0.75rem 0;">1. Identificación del Titular y Responsable (LSSI-CE Art. 10 / RGPD Art. 13)</h2>
        <ul class="project-highlights" style="font-size:0.96rem;margin-bottom:0;">
          <li><strong>Titular y Responsable del Sitio Web:</strong> {profile.name} (<code>@{profile.handle}</code>)</li>
          <li><strong>Ubicación:</strong> {profile.location.es}</li>
          <li><strong>Correo electrónico de contacto y ejercicio de derechos:</strong> protegido frente a bots mediante <button type="button" class="btn-control" data-contact-trigger data-subject="Consulta Legal o Privacidad" style="display:inline-flex;padding:0.2rem 0.55rem;">✉ Verificación Anti-Bot de Correo</button></li>
          <li><strong>Dominio:</strong> <code>https://jonimax11000.com</code> (Sitio web informativo y portfolio profesional personal sin ánimo de lucro ni venta comercial directa).</li>
        </ul>
      </div>

      <!-- 2. Cobertura Normativa por Jurisdicción -->
      <div class="bento-grid" style="margin-bottom:2rem;">
        <article class="card">
          <span class="badge badge-featured" style="align-self:flex-start;margin-bottom:0.75rem;">Unión Europea &amp; España</span>
          <h2 style="font-size:1.15rem;margin:0 0 0.6rem 0;">RGPD, LOPDGDD &amp; LSSI-CE</h2>
          <p style="color:var(--text-secondary);font-size:0.92rem;margin:0;">
            Cumple con el <strong>Reglamento (UE) 2016/679 (RGPD)</strong>, la <strong>Ley Orgánica 3/2018 (LOPDGDD)</strong>, la <strong>LSSI-CE (Ley 34/2002)</strong> y la <strong>Directiva ePrivacy</strong>. Se garantizan los derechos de acceso, rectificación, supresión, oposición, limitación y portabilidad ante el titular o la <strong>AEPD</strong>. Las tipografías se sirven en local (self-hosted), sin conexión ni cesión de IP a servidores externos de Google Fonts.
          </p>
        </article>

        <article class="card">
          <span class="badge badge-public" style="align-self:flex-start;margin-bottom:0.75rem;">Reino Unido (UK)</span>
          <h2 style="font-size:1.15rem;margin:0 0 0.6rem 0;">UK GDPR, DPA 2018 &amp; PECR</h2>
          <p style="color:var(--text-secondary);font-size:0.92rem;margin:0;">
            Alineado con el <strong>UK General Data Protection Regulation (UK GDPR)</strong>, la <strong>Data Protection Act 2018</strong> y las <strong>Privacy and Electronic Communications Regulations (PECR)</strong>, reconociendo la autoridad supervisora de la <strong>Information Commissioner's Office (ICO)</strong>.
          </p>
        </article>

        <article class="card">
          <span class="badge badge-lang" style="align-self:flex-start;margin-bottom:0.75rem;">Estados Unidos (USA)</span>
          <h2 style="font-size:1.15rem;margin:0 0 0.6rem 0;">CCPA/CPRA, Leyes Estatales &amp; COPPA</h2>
          <p style="color:var(--text-secondary);font-size:0.92rem;margin:0;">
            Cumple con la <strong>CCPA/CPRA</strong> (California), <strong>VCDPA</strong> (Virginia), <strong>CPA</strong> (Colorado), <strong>CTDPA</strong> (Connecticut) y <strong>TDPSA</strong> (Texas): <strong>no vendemos ni compartimos información personal</strong> y no discriminamos por el ejercicio de derechos. Conforme a <strong>COPPA</strong>, este sitio no está dirigido ni recopila datos de menores de 13 años.
          </p>
        </article>
      </div>

      <!-- 3. Sudamérica / Latinoamérica -->
      <div class="card" style="margin-bottom:2rem;">
        <h2 style="font-size:1.3rem;margin:0 0 0.85rem 0;">2. Cumplimiento Específico en Sudamérica</h2>
        <p style="color:var(--text-secondary);margin:0 0 0.85rem 0;">
          Para visitantes residentes en América del Sur, este sitio web aplica los principios de licitud, minimización, finalidad y transparencia exigidos por las legislaciones nacionales vigentes:
        </p>
        <ul class="project-highlights" style="font-size:0.95rem;margin-bottom:0;">
          <li><strong>Brasil — LGPD (Lei Geral de Proteção de Dados, Lei nº 13.709/2018):</strong> Respeto íntegro a los derechos del titular del Art. 18 (confirmación, acceso, corrección, anonimización, eliminación y revocación) bajo supervisión de la <strong>ANPD</strong>.</li>
          <li><strong>Argentina — Ley 25.326 de Protección de Datos Personales:</strong> Garantía de derechos de acceso, rectificación y supresión ante la <strong>AAIP</strong> (Agencia de Acceso a la Información Pública).</li>
          <li><strong>Colombia — Ley Estatutaria 1581 de 2012 (Habeas Data) y Decreto 1377 de 2013:</strong> Principio de autorización previa y respeto a la autoridad de la <strong>SIC</strong> (Superintendencia de Industria y Comercio).</li>
          <li><strong>Chile — Ley 19.628 y reforma Ley 21.719:</strong> Protección de la vida privada y autodeterminación informativa sobre cualquier comunicación voluntaria por correo electrónico.</li>
          <li><strong>Perú (Ley 29733), Uruguay (Ley 18.331) y Ecuador (LOPDP):</strong> Minimización estricta de datos, transparencia y canales directos gratuitos para el ejercicio de derechos ARCO.</li>
        </ul>
      </div>

      <!-- 4. Tratamiento real de datos, GitHub Pages y Propiedad Intelectual -->
      <div class="card" style="margin-bottom:2rem;">
        <h2 style="font-size:1.3rem;margin:0 0 0.85rem 0;">3. Tratamiento de Datos, Alojamiento y Propiedad Intelectual</h2>
        <ul class="project-highlights" style="font-size:0.95rem;margin-bottom:0;">
          <li><strong>Comunicaciones voluntarias por Email:</strong> El sitio no contiene formularios ni bases de datos. Si escribes voluntariamente al correo del titular (tras superar la verificación local anti-spam), tus datos se tratarán exclusivamente para responder a tu consulta profesional o laboral (base legal: consentimiento e interés precontractual) y se eliminarán cuando ya no sean necesarios o cuando lo solicites.</li>
          <li><strong>Alojamiento en GitHub Pages:</strong> La infraestructura estática se sirve mediante GitHub Pages (GitHub, Inc.), que procesa registros técnicos mínimos de conexión (dirección IP y cabeceras HTTP) exclusivamente por seguridad, disponibilidad y mitigación de ataques, bajo sus garantías de transferencia internacional.</li>
          <li><strong>Fuentes Tipográficas en Local (Zero Leak):</strong> Las tipografías <em>Inter</em> y <em>JetBrains Mono</em> están empaquetadas y autoalojadas dentro del propio sitio web; el navegador <strong>no realiza peticiones a servidores de terceros</strong> (como Google Fonts CDN) al visitar esta web.</li>
          <li><strong>Propiedad Intelectual y Proyectos Privados:</strong> Los contenidos, textos y diseños del portfolio pertenecen a {profile.name}. Los repositorios públicos enlazan a sus respectivas licencias en GitHub; los repositorios marcados como <em>Privado</em> muestran únicamente fichas descriptivas sin exponer código fuente ni rutas de acceso.</li>
        </ul>
      </div>

      <div class="card">
        <h2 style="font-size:1.25rem;margin:0 0 0.75rem 0;">4. Contacto Legal y Ejercicio de Derechos</h2>
        <p style="color:var(--text-secondary);margin:0 0 1rem 0;">
          Para ejercer cualquier derecho de privacidad (acceso, rectificación, supresión, oposición, portabilidad o consulta legal), escribe directamente a:
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;">
          <button type="button" class="btn-primary" data-contact-trigger data-subject="Consulta Legal o Privacidad">
            ✉ Contactar por correo (Protegido Anti-Bot)
          </button>
          <a href="/cookies/" class="btn-secondary">Política de Cookies</a>
          <a href="/accesibilidad/" class="btn-secondary">Accesibilidad Legal</a>
          <a href="/" class="btn-control">← Volver al inicio</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

