---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import projectsData from '../../data/projects.json';
import profile from '../../data/profile.json';
import { ui } from '../../i18n/ui';

export const getStaticPaths = (({ paginate }) => {
  return paginate(projectsData.projects, { pageSize: 6 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const lang = 'es';
const t = ui[lang];

const title = `${t.catalog.title} (${t.catalog.showingPage} ${page.currentPage} ${t.catalog.of} ${page.lastPage}) — ${profile.name}`;
const description = `Catálogo paginado de proyectos públicos y privados de ${profile.name} (${t.catalog.showingPage} ${page.currentPage} de ${page.lastPage}): Python, Odoo ERP, IA, Big Data, Flutter y Realidad Virtual.`;

const canonicalPath = `/proyectos/${page.currentPage}/`;
const alternateEnPath = `/en/projects/${page.currentPage}/`;
const prevUrl = page.url.prev ? `${page.url.prev}/`.replace(/\/\/$/, '/') : undefined;
const nextUrl = page.url.next ? `${page.url.next}/`.replace(/\/\/$/, '/') : undefined;
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  canonicalPath={canonicalPath}
  alternateEsPath={canonicalPath}
  alternateEnPath={alternateEnPath}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
>
  <section class="section" aria-labelledby="paginated-catalog-heading">
    <div class="container">
      <div class="section-header" style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:1rem;">
        <div>
          <span class="section-tag">{t.catalog.sectionTag} · {t.catalog.showingPage.toUpperCase()} {page.currentPage}/{page.lastPage}</span>
          <h1 id="paginated-catalog-heading" class="section-title">
            {t.catalog.title} — {t.catalog.showingPage} {page.currentPage} {t.catalog.of} {page.lastPage}
          </h1>
          <p class="section-subtitle">
            {t.catalog.subtitle} ({page.total} {t.catalog.totalProjectsLabel}).
          </p>
        </div>
        <a href="/#todos-los-proyectos" class="btn-secondary">
          ← {t.catalog.backToHome}
        </a>
      </div>

      <div class="projects-grid">
        {page.data.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>

      <nav class="pagination-nav" aria-label="Paginación estática de proyectos">
        <a
          href={page.url.prev ? `/proyectos/${page.currentPage - 1}/` : undefined}
          class="page-btn"
          aria-disabled={!page.url.prev ? 'true' : undefined}
        >
          ← {t.catalog.prevPage}
        </a>

        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => (
          <a
            href={`/proyectos/${num}/`}
            class="page-btn"
            aria-current={num === page.currentPage ? 'page' : undefined}
            aria-label={`${t.catalog.pageLinkAria} ${num}`}
          >
            {num}
          </a>
        ))}

        <a
          href={page.url.next ? `/proyectos/${page.currentPage + 1}/` : undefined}
          class="page-btn"
          aria-disabled={!page.url.next ? 'true' : undefined}
        >
          {t.catalog.nextPage} →
        </a>
      </nav>
    </div>
  </section>
</BaseLayout>
