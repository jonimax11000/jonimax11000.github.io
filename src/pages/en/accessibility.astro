---
import BaseLayout from '../../layouts/BaseLayout.astro';
import profile from '../../data/profile.json';

const title = `Legal Accessibility Statement (EU, UK, South America & US Law) — ${profile.name}`;
const description =
  'Official web accessibility conformance statement compliant with European Union (EN 301 549, EAA, RD 1112/2018), United Kingdom (Equality Act 2010, PSBAR), South American (Brazil LBI, Argentina Law 26.653, Colombia Res. 1519), and US (ADA Title III, Section 508) standards under WCAG 2.1 / 2.2 AA.';
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  canonicalPath="/en/accessibility/"
  alternateEsPath="/accesibilidad/"
  alternateEnPath="/en/accessibility/"
>
  <section class="section" aria-labelledby="a11y-legal-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">// EU · UK · SOUTH AMERICA · US LEGAL COMPLIANCE</span>
        <h1 id="a11y-legal-heading" class="section-title">
          Accessibility &amp; Legal Conformance Statement
        </h1>
        <p class="section-subtitle">
          Universal accessibility commitment compliant with European Union, United Kingdom, South American, and United States regulations.
        </p>
      </div>

      <div class="bento-grid" style="margin-bottom:2rem;">
        <article class="card">
          <span class="badge badge-featured" style="align-self:flex-start;margin-bottom:0.75rem;">EU, Spain &amp; UK</span>
          <h2 style="font-size:1.2rem;margin:0 0 0.65rem 0;">EN 301 549, EAA &amp; UK Equality Act</h2>
          <p style="color:var(--text-secondary);font-size:0.94rem;margin:0;">
            Engineered to meet <strong>EN 301 549 v3.2.1</strong>, <strong>Directive (EU) 2016/2102</strong>, the <strong>European Accessibility Act (EU 2019/882)</strong>, and Spain's <strong>RD 1112/2018</strong>, plus the UK <strong>Equality Act 2010</strong> and <strong>PSBAR 2018</strong>.
          </p>
        </article>

        <article class="card">
          <span class="badge badge-public" style="align-self:flex-start;margin-bottom:0.75rem;">South America (LATAM)</span>
          <h2 style="font-size:1.2rem;margin:0 0 0.65rem 0;">Brazil LBI, Argentina, Colombia &amp; Region</h2>
          <p style="color:var(--text-secondary);font-size:0.94rem;margin:0;">
            Aligned with Brazil's <strong>Lei Brasileira de Inclusão (Law 13.146/2015, Art. 63)</strong> &amp; eMAG, Argentina's <strong>Law 26.653</strong>, Colombia's <strong>Resolution 1519/2020</strong>, Chile's <strong>Law 20.422</strong>, Peru's <strong>Law 29973</strong>, and Uruguay's <strong>Decree 406/022</strong>.
          </p>
        </article>

        <article class="card">
          <span class="badge badge-lang" style="align-self:flex-start;margin-bottom:0.75rem;">United States &amp; W3C</span>
          <h2 style="font-size:1.2rem;margin:0 0 0.65rem 0;">ADA Title III, Section 508 &amp; WCAG 2.2 AA</h2>
          <p style="color:var(--text-secondary);font-size:0.94rem;margin:0;">
            Conforms to U.S. Department of Justice <strong>ADA Title III</strong> and <strong>Section 508 (29 U.S.C. § 794d)</strong> under <strong>WCAG 2.1 / 2.2 Level AA</strong>, with optional <strong>Level AAA</strong> high contrast.
          </p>
        </article>
      </div>

      <div class="card" style="margin-bottom:2rem;">
        <h2 style="font-size:1.35rem;margin:0 0 1rem 0;">Implemented Technical &amp; Assistive Features</h2>
        <ul class="project-highlights" style="font-size:0.98rem;">
          <li>
            <strong>Color-Blindness Assistance (Color Vision Deficiency):</strong> Built-in SVG color matrix filters calibrated for <em>Protanopia</em> (red deficiency), <em>Deuteranopia</em> (green deficiency), <em>Tritanopia</em> (blue-yellow deficiency), and <em>Achromatopsia</em>, combined with non-color visual indicators such as icons and dashed borders (WCAG 1.4.1).
          </li>
          <li>
            <strong>Light Mode, Dark Mode &amp; High Contrast (WCAG AAA):</strong> Persistent theme switching alongside a dedicated high-contrast mode exceeding 7:1 contrast ratios (WCAG 1.4.3 &amp; 1.4.6).
          </li>
          <li>
            <strong>Scalable Typography &amp; Dyslexia Reading Mode:</strong> Instant font scaling (100%, 112%, 125%) without horizontal scrolling or layout loss, plus dyslexia-friendly character, word, and line spacing (WCAG 1.4.4 &amp; 1.4.12).
          </li>
          <li>
            <strong>100% Keyboard Navigation &amp; Screen Reader Support:</strong> Skip-to-main-content link, logical focus order, high-visibility focus rings (<code>:focus-visible</code>), semantic landmarks, and <code>Escape</code> key dialog dismissal (WCAG 2.1.1, 2.4.1 &amp; 2.4.7).
          </li>
          <li>
            <strong>Reduced Motion Control:</strong> Automatic adherence to <code>prefers-reduced-motion: reduce</code> and manual animation suppression toggle (WCAG 2.3.3).
          </li>
          <li>
            <strong>Semantic Multilingual Markup:</strong> Explicit <code>lang="en-GB"</code> and <code>lang="es-ES"</code> attributes and reciprocal <code>hreflang</code> links (WCAG 3.1.1).
          </li>
        </ul>
      </div>

      <div class="card">
        <h2 style="font-size:1.25rem;margin:0 0 0.75rem 0;">Accessibility Feedback &amp; Contact Channel</h2>
        <p style="color:var(--text-secondary);margin:0 0 1rem 0;">
          If you experience any accessibility barrier or require content in an alternative format under EU (EN 301 549 / EAA) or US (ADA / Section 508) regulations, please contact:
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;">
          <a href={`mailto:${profile.email}?subject=Web%20Accessibility%20Feedback`} class="btn-primary">
            ✉ {profile.email}
          </a>
          <a href="/en/" class="btn-secondary">
            ← Back to portfolio home
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

